# Reasoning engine for the sourcing agent and planner:
#   demo      - deterministic rules, no key needed
#   groq      - free key from https://console.groq.com/keys (recommended by the event guide)
#   anthropic - Claude via ANTHROPIC_API_KEY
AGENT_MODE=demo
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b. Any Groq model with tool use works.
GROQ_MODEL=
# Optional; any OpenAI-compatible endpoint. Defaults to https://api.groq.com/openai/v1
GROQ_BASE_URL=
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# fastn MCP gateway (https://app.fastn.ai). Used by recovery dispatch and TOOL_MODE=fastn.
FASTN_API_KEY=
FASTN_PROJECT_ID=
# Optional; defaults to https://mcp.live.fastn.ai/shttp/tools
FASTN_MCP_URL=

# Recovery dispatch: after a request is verified, run one fastn connector action
# (Slack message, Google Sheets row, Jira issue...). Find the action with:
#   python -m backend.fastn_discover "send a Slack message to a channel"
DISPATCH_MODE=off
FASTN_DISPATCH_ACTION_ID=
# JSON matching the action's inputSchema. Placeholders: {message} {case_id} {title} {item}
# {quantity} {supplier} {total} {lead_days} {request_id} {evidence_id} {note} {location}
FASTN_DISPATCH_PARAMS='{"channel": "#procurement", "text": "{message}"}'
FASTN_DISPATCH_CONNECTION_ID=
FASTN_DISPATCH_LABEL='Slack #procurement'

# demo: local purchase-request ledger. fastn: custom request-ledger tools (see docs/INTEGRATIONS.md).
TOOL_MODE=demo
FASTN_SNAPSHOT_TOOL=reroute_get_snapshot
FASTN_CREATE_TOOL=reroute_create_request
FASTN_LOOKUP_TOOL=reroute_get_request

# PostgreSQL for deployed use; SQLite is a persistent local development default.
DATABASE_URL=sqlite:///./data/reroute.db
# Required whenever AGENT_MODE, TOOL_MODE or DISPATCH_MODE is not demo/off.
APP_TOKEN=
PORT=8000
