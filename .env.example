# demo: deterministic reasoning + synthetic records. anthropic enables Claude.
AGENT_MODE=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# demo: local purchase-request ledger. fastn: real MCP tools, no silent fallback.
TOOL_MODE=demo
FASTN_MCP_URL=
FASTN_MCP_TOKEN=
FASTN_SNAPSHOT_TOOL=reroute_get_snapshot
FASTN_CREATE_TOOL=reroute_create_request
FASTN_LOOKUP_TOOL=reroute_get_request
# PostgreSQL for deployed use; SQLite is a persistent local development default.
DATABASE_URL=sqlite:///./data/reroute.db
# Required whenever AGENT_MODE or TOOL_MODE is not demo.
APP_TOKEN=
PORT=8000
